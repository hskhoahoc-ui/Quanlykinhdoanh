<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hệ Thống Giải Pháp Kinh Doanh</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .solution-card {
            transition: transform 0.2s;
        }
        .solution-card:hover {
            transform: translateY(-5px);
        }
        .marquee-box {
            background-color: #fff3cd;
            color: #856404;
            padding: 8px;
            font-size: 14px;
            border-radius: 4px;
            margin-bottom: 12px;
            border: 1px solid #ffeeba;
        }
    </style>
</head>
<body class="bg-light">
    <!-- Navbar trang chủ -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" href="/">Hệ Thống Giải Pháp</a>
            <a href="/login" class="btn btn-outline-light btn-sm">Quản Trị Hệ Thống</a>
        </div>
    </nav>

    <div class="container mb-5">
        <h2 class="text-center mb-4">Danh Sách Giải Pháp Quản Lý & Kinh Doanh</h2>
        
        <div class="row">
            <% if (solutions && solutions.length > 0) { %>
                <% solutions.forEach(sol => { %>
                    <div class="col-md-4 mb-4">
                        <div class="card solution-card shadow-sm h-100 p-3">
                            
                            <!-- VÙNG DÒNG CHỮ CHẠY TRÊN Ô SẢN PHẨM -->
                            <div class="marquee-box">
                                <marquee behavior="scroll" direction="left" scrollamount="4">
                                    Giải pháp tối ưu: vừa là web bán hàng, vừa là giải pháp quản lý.
                                </marquee>
                                <marquee behavior="scroll" direction="left" scrollamount="4" style="color: #0c5460;">
                                    Mua 1 lần sử dụng dài lâu với chi phí thấp.
                                </marquee>
                            </div>
                            <!-- KẾT THÚC DÒNG CHỮ CHẠY -->

                            <% if (sol.image) { %>
                                <img src="<%= sol.image %>" class="card-img-top rounded" alt="Image" style="height: 180px; object-fit: cover;">
                            <% } else { %>
                                <div class="bg-secondary text-white text-center d-flex align-items-center justify-content-center rounded" style="height: 180px;">
                                    Không có hình ảnh
                                </div>
                            <% } %>

                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title text-primary"><%= sol.name %></h5>
                                <p class="card-text mb-1"><strong>SĐT:</strong> <%= sol.phone || 'Chưa cập nhật' %></p>
                                <p class="card-text mb-3"><strong>Địa chỉ:</strong> <%= sol.address || 'Chưa cập nhật' %></p>
                                
                                <div class="mt-auto d-flex justify-content-between">
                                    <% if (sol.demo_link) { %>
                                        <a href="<%= sol.demo_link %>" target="_blank" class="btn btn-primary btn-sm">Xem Demo</a>
                                    <% } %>
                                    <% if (sol.catalog_link) { %>
                                        <a href="<%= sol.catalog_link %>" target="_blank" class="btn btn-outline-secondary btn-sm">Xem Catalog</a>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="col-12 text-center">
                    <p class="text-muted">Chưa có giải pháp nào được cập nhật.</p>
                </div>
            <% } %>
        </div>
    </div>
</body>
</html>
