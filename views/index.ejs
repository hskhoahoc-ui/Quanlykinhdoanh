<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HỆ THỐNG GIẢI PHÁP QUẢN LÝ KINH DOANH</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        .solution-card { transition: transform 0.2s; }
        .solution-card:hover { transform: translateY(-5px); }
        .marquee-container {
            background-color: #fff3cd;
            color: #856404;
            padding: 10px 0;
            border-bottom: 1px solid #ffeeba;
            font-weight: 500;
        }
        .price-tag {
            color: #d63384;
            font-weight: bold;
            font-size: 1.1rem;
        }
    </style>
</head>
<body class="bg-light d-flex flex-column min-vh-100">
    <!-- Navbar / Thanh tiêu đề có SĐT và Địa chỉ đồng bộ từ Database -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/">CHUYÊN CUNG CẤP VÀ GIA CÔNG PHẦN MỀM</a>
            <div class="text-white small d-none d-md-block">
                <span class="me-3">📞 SĐT: <strong><%= settings.phone || '0852130163' %></strong></span>
                <span>📍 Địa chỉ: <strong><%= settings.address || '153E/8 Trần Hưng Đạo P.Bình Đức An Giang' %></strong></span>
            </div>
            <a href="/login" class="btn btn-outline-light btn-sm">Quản Trị</a>
        </div>
    </nav>

    <!-- Dòng chữ chạy 01 lần dưới thanh tiêu đề -->
    <div class="marquee-container mb-4">
        <div class="container">
            <marquee behavior="scroll" direction="left" scrollamount="5">
                🌟 Giải pháp tối ưu: vừa là web bán hàng, vừa là giải pháp quản lý. &nbsp;&nbsp;&nbsp;|&nbsp;&nbsp;&nbsp; 🚀 Mua 1 lần sử dụng dài lâu với chi phí thấp.
            </marquee>
        </div>
    </div>

    <div class="container mb-5 flex-grow-1">
        <h2 class="text-center mb-4">DANH MỤC CÁC GIẢI PHÁP</h2>
        
        <div class="row">
            <% if (solutions && solutions.length > 0) { %>
                <% solutions.forEach(sol => { %>
                    <div class="col-md-4 mb-4">
                        <div class="card solution-card shadow-sm h-100 p-3">
                            <% if (sol.image) { %>
                                <img src="<%= sol.image %>" class="card-img-top rounded" alt="Image" style="height: 180px; object-fit: cover;">
                            <% } else { %>
                                <div class="bg-secondary text-white text-center d-flex align-items-center justify-content-center rounded" style="height: 180px;">
                                    Không có hình ảnh
                                </div>
                            <% } %>

                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title text-primary"><%= sol.name %></h5>
                                <!-- Hiển thị giá bán dạng biểu tượng chú thích hình sao ⭐ -->
                                <p class="card-text mb-2">
                                    <span title="Giá bán sản phẩm">⭐</span> <span class="price-tag"><%= sol.price ? sol.price : 'Liên hệ' %></span>
                                </p>
                                <div class="mt-auto d-flex justify-content-between pt-3">
                                    <% if (sol.demo_link) { %>
                                        <a href="<%= sol.demo_link %>" target="_blank" class="btn btn-primary btn-sm">Xem Demo</a>
                                    <% } %>
                                    <% if (sol.catalog_link) { %>
                                        <a href="<%= sol.catalog_link %>" target="_blank" class="btn btn-outline-secondary btn-sm">Xem Catalog</a>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="col-12 text-center">
                    <p class="text-muted">Chưa có giải pháp nào.</p>
                </div>
            <% } %>
        </div>
    </div>

    <!-- Dòng thông tin DOANH NGHIỆP TƯ NHÂN THIÊN LONG ở phía dưới cùng trang -->
    <footer class="bg-dark text-white text-center py-3 mt-auto">
        <div class="container">
            <small>Copyright@ - <strong> CÔNG TY TNHH TMDV CÁT TƯỜNG GOBAL 🌐https://quanlykinhdoanh.onrender.com/</strong></small>
        </div>
    </footer>
</body>
</html>
