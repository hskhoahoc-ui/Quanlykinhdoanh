<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trang Quản Trị Hệ Thống</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" href="/admin">Quản Trị Hệ Thống</a>
            <div class="d-flex align-items-center text-white">
                <span class="me-3">Xin chào: <strong><%= user.username %></strong> (<%= user.role %>)</span>
                <a href="/" class="btn btn-outline-light btn-sm me-2" target="_blank">Xem trang chủ</a>
                <a href="/logout" class="btn btn-danger btn-sm">Đăng xuất</a>
            </div>
        </div>
    </nav>

    <div class="container">
        <!-- Hàng chức năng -->
        <div class="row">
            <!-- Cột trái: Thêm Giải Pháp Mới -->
            <div class="col-md-6 mb-4">
                <div class="card shadow p-4">
                    <h4 class="mb-3">Thêm Giải Pháp Mới</h4>
                    <form action="/admin/solution/add" method="POST" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label class="form-label">Tên Giải Pháp</label>
                            <input type="text" name="name" class="form-control" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Hình Ảnh (Banner/Icon)</label>
                            <input type="file" name="image" class="form-control" accept="image/*">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Link Demo</label>
                            <input type="url" name="demo_link" class="form-control" placeholder="https://...">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Link Catalog</label>
                            <input type="url" name="catalog_link" class="form-control" placeholder="https://...">
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Lưu Giải Pháp</button>
                    </form>
                </div>
            </div>

            <!-- Cột phải: Đổi Mật Khẩu Cá Nhân -->
            <div class="col-md-6 mb-4">
                <div class="card shadow p-4">
                    <h4 class="mb-3">Đổi Mật Khẩu</h4>
                    <form action="/admin/change-password" method="POST">
                        <div class="mb-3">
                            <label class="form-label">Mật khẩu hiện tại</label>
                            <input type="password" name="current_password" class="form-control" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Mật khẩu mới</label>
                            <input type="password" name="new_password" class="form-control" required>
                        </div>
                        <button type="submit" class="btn btn-warning w-100">Cập nhật mật khẩu</button>
                    </form>
                </div>
            </div>
        </div>

        <% if (user.role === 'admin') { %>
        <!-- Khu vực quản lý dành riêng cho Admin (Thêm/Xóa Nhân viên) -->
        <div class="card shadow p-4 mb-4">
            <h4 class="mb-3">Quản Lý Tài Khoản Nhân Viên</h4>
            <form action="/admin/user/add" method="POST" class="row g-3 mb-4">
                <div class="col-md-5">
                    <input type="text" name="username" class="form-control" placeholder="Tên đăng nhập nhân viên mới" required>
                </div>
                <div class="col-md-5">
                    <input type="password" name="password" class="form-control" placeholder="Mật khẩu" required>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-success w-100">Thêm NV</button>
                </div>
            </form>

            <div class="table-responsive">
                <table class="table table-bordered align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Tên đăng nhập</th>
                            <th>Quyền hạn</th>
                            <th>Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% users.forEach(u => { %>
                        <tr>
                            <td><%= u.id %></td>
                            <td><%= u.username %></td>
                            <td><span class="badge <%= u.role === 'admin' ? 'bg-danger' : 'bg-secondary' %>"><%= u.role %></span></td>
                            <td>
                                <% if (u.username !== 'admin') { %>
                                <form action="/admin/user/delete/<%= u.id %>" method="POST" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa nhân viên này?');">
                                    <button type="submit" class="btn btn-danger btn-sm">Xóa</button>
                                </form>
                                <% } else { %>
                                <span class="text-muted">Không thể xóa</span>
                                <% } %>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
        <% } %>

        <!-- Danh sách Giải pháp hiện có -->
        <div class="card shadow p-4 mb-5">
            <h4 class="mb-3">Danh Sách Giải Pháp Đang Hiển Thị</h4>
            <div class="table-responsive">
                <table class="table table-striped align-middle">
                    <thead>
                        <tr>
                            <th>Hình ảnh</th>
                            <th>Tên giải pháp</th>
                            <th>Link Demo</th>
                            <th>Link Catalog</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% solutions.forEach(sol => { %>
                        <tr>
                            <td>
                                <% if (sol.image) { %>
                                <img src="<%= sol.image %>" alt="img" style="width: 50px; height: 50px; object-fit: cover;" class="rounded">
                                <% } else { %>
                                <span class="text-muted">Không có</span>
                                <% } %>
                            </td>
                            <td><strong><%= sol.name %></strong></td>
                            <td><a href="<%= sol.demo_link %>" target="_blank"><%= sol.demo_link %></a></td>
                            <td><a href="<%= sol.catalog_link %>" target="_blank"><%= sol.catalog_link %></a></td>
                            <td>
                                <form action="/admin/solution/delete/<%= sol.id %>" method="POST" onsubmit="return confirm('Bạn có muốn xóa giải pháp này không?');">
                                    <button type="submit" class="btn btn-danger btn-sm">Xóa</button>
                                </form>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</body>
</html>
