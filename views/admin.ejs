<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trang Quản Trị Hệ Thống</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" href="/admin">Quản Trị Hệ Thống</a>
            <div class="d-flex align-items-center text-white">
                <span class="me-3">Xin chào: <strong><%= user.username %></strong></span>
                <a href="/" class="btn btn-outline-light btn-sm me-2" target="_blank">Xem trang chủ</a>
                <a href="/logout" class="btn btn-danger btn-sm">Đăng xuất</a>
            </div>
        </div>
    </nav>

    <div class="container">
        <!-- Hàng 1: Cài đặt SĐT/Địa chỉ tiêu đề & Đổi mật khẩu -->
        <div class="row">
            <div class="col-md-6 mb-4">
                <div class="card shadow p-4">
                    <h4 class="mb-3">Cài Đặt Tiêu Đề (SĐT & Địa Chỉ)</h4>
                    <form action="/admin/settings/update" method="POST">
                        <div class="mb-3">
                            <label class="form-label">Số Điện Thoại Hiển Thị</label>
                            <input type="text" name="phone" value="<%= settings.phone %>" class="form-control" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Địa Chỉ Hiển Thị</label>
                            <input type="text" name="address" value="<%= settings.address %>" class="form-control" required>
                        </div>
                        <button type="submit" class="btn btn-info text-white w-100">Cập Nhật Tiêu Đề</button>
                    </form>
                </div>
            </div>

            <div class="col-md-6 mb-4">
                <div class="card shadow p-4">
                    <h4 class="mb-3">Đổi Mật Khẩu Cá Nhân</h4>
                    <form action="/admin/change-password" method="POST">
                        <div class="mb-3">
                            <label class="form-label">Mật khẩu hiện tại</label>
                            <input type="password" name="current_password" class="form-control" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Mật khẩu mới</label>
                            <input type="password" name="new_password" class="form-control" required>
                        </div>
                        <button type="submit" class="btn btn-warning w-100">Đổi Mật Khẩu</button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Hàng 2: Thêm Giải Pháp Mới (Dùng link ảnh) -->
        <div class="card shadow p-4 mb-4">
            <h4 class="mb-3">Thêm Giải Pháp Mới</h4>
            <form action="/admin/solution/add" method="POST" class="row g-3">
                <div class="col-md-3">
                    <input type="text" name="name" class="form-control" placeholder="Tên giải pháp" required>
                </div>
                <div class="col-md-3">
                    <input type="url" name="image" class="form-control" placeholder="Link hình ảnh (URL)" required>
                </div>
                <div class="col-md-2">
                    <input type="url" name="demo_link" class="form-control" placeholder="Link Demo">
                </div>
                <div class="col-md-2">
                    <input type="url" name="catalog_link" class="form-control" placeholder="Link Catalog">
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">Thêm Mới</button>
                </div>
            </form>
        </div>

        <!-- Danh sách Giải pháp (Có kèm tính năng Sửa / Cập nhật và Xóa) -->
        <div class="card shadow p-4 mb-5">
            <h4 class="mb-3">Danh Sách Giải Pháp & Cập Nhật</h4>
            <div class="table-responsive">
                <table class="table table-bordered align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Ảnh</th>
                            <th>Tên Giải Pháp</th>
                            <th>Đường Dẫn (Links)</th>
                            <th>Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% solutions.forEach(sol => { %>
                        <form action="/admin/solution/update/<%= sol.id %>" method="POST">
                            <tr>
                                <td style="width: 80px;">
                                    <% if (sol.image) { %>
                                    <img src="<%= sol.image %>" alt="img" style="width: 50px; height: 50px; object-fit: cover;" class="rounded mb-1">
                                    <% } %>
                                    <input type="text" name="image" value="<%= sol.image %>" class="form-control form-control-sm" placeholder="Link ảnh">
                                </td>
                                <td>
                                    <input type="text" name="name" value="<%= sol.name %>" class="form-control form-control-sm" required>
                                </td>
                                <td>
                                    <div class="mb-1"><input type="url" name="demo_link" value="<%= sol.demo_link %>" class="form-control form-control-sm" placeholder="Link Demo"></div>
                                    <div><input type="url" name="catalog_link" value="<%= sol.catalog_link %>" class="form-control form-control-sm" placeholder="Link Catalog"></div>
                                </td>
                                <td style="width: 150px;">
                                    <button type="submit" class="btn btn-success btn-sm w-100 mb-1">Cập Nhật</button>
                                </form>
                                    <form action="/admin/solution/delete/<%= sol.id %>" method="POST" onsubmit="return confirm('Bạn có chắc muốn xóa?');">
                                        <button type="submit" class="btn btn-danger btn-sm w-100">Xóa</button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </div>

        <% if (user.role === 'admin') { %>
        <!-- Quản lý nhân viên -->
        <div class="card shadow p-4 mb-5">
            <h4 class="mb-3">Quản Lý Tài Khoản Nhân Viên</h4>
            <form action="/admin/user/add" method="POST" class="row g-3 mb-3">
                <div class="col-md-5">
                    <input type="text" name="username" class="form-control" placeholder="Tên đăng nhập" required>
                </div>
                <div class="col-md-5">
                    <input type="password" name="password" class="form-control" placeholder="Mật khẩu" required>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-secondary w-100">Thêm NV</button>
                </div>
            </form>
            <ul class="list-group">
                <% users.forEach(u => { %>
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <%= u.username %> (<%= u.role %>)
                        <% if (u.username !== 'admin') { %>
                        <form action="/admin/user/delete/<%= u.id %>" method="POST" onsubmit="return confirm('Xóa nhân viên này?');">
                            <button type="submit" class="btn btn-danger btn-sm">Xóa</button>
                        </form>
                        <% } %>
                    </li>
                <% }) %>
            </ul>
        </div>
        <% } %>
    </div>
</body>
</html>
